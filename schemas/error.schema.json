{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryCore MVP Error",
  "type": "object",
  "required": ["code", "category", "message"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "validation",
        "unsupported_operation",
        "missing_backend",
        "backend_unavailable",
        "pointer_missing",
        "verification_unsupported",
        "unknown_failure"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "verification_state": {
      "type": "string",
      "enum": ["missing", "unsupported", "unknown"]
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
